# Copy to .env.production for Docker Compose; do not commit the real file.
APP_ENV=production
DATA_DIR=/data
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
APP_ACCESS_USERNAME=campus
APP_ACCESS_PASSWORD=change_this_to_a_unique_random_password
# Add the actual public hostname after choosing a cloud provider.
ALLOWED_HOSTS=localhost,127.0.0.1
# Same-origin frontend needs no cross-origin allowance.
CORS_ORIGINS=
ENABLE_API_DOCS=false
# Set trusted proxy IPs for your hosting platform. Never use * on a directly exposed server.
FORWARDED_ALLOW_IPS=127.0.0.1
# Optional overrides; both paths must stay inside DATA_DIR in production.
# DATABASE_URL=sqlite:////data/database.db
# UPLOAD_DIR=/data/uploads
